# GEMINI_API_KEY: Required for Gemini AI API calls.
# Configure this secret in your deployment provider's environment variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Public base URL used for self-referential links and OAuth callbacks.
APP_URL="MY_APP_URL"

# HACKMIND — provedores de IA (somente backend)
GROQ_API_KEY=
NVIDIA_NIM_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5
CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=
AI_DEFAULT_PROVIDER=engine
AI_DEFAULT_MODEL=
