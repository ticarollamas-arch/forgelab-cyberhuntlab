# Portal ForgeLab Studio
PORT=4173

# Acesso administrativo — configure valores fortes no ambiente de deploy
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Persistência Supabase (obrigatória para usuários, preços e configurações administrativas)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
APP_ENCRYPTION_KEY=
JWT_SECRET=

# GitHub Intelligence / provedores (preencha apenas os que utilizar)
GITHUB_TOKEN=
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_NIM_API_KEY=
NVIDIA_API_KEY=
AI_DEFAULT_PROVIDER=groq
AI_DEFAULT_MODEL=llama-3.3-70b-versatile

# Hackmind / modelos locais ou endpoints compatíveis
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5
CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=

# Os .env.example específicos dos módulos também devem ser consultados.
# Nunca versione valores reais de chaves, tokens ou senhas.
